import React, { useState, useEffect, useRef } from 'react';
import { marked } from 'marked';
import { Menu, User, Plus, Settings, Video, BrainCircuit, LayoutTemplate, Send, Bot, Code, Eye, Pencil, X, Image as ImageIcon, Sparkles, Paperclip, LoaderCircle } from 'lucide-react';

// --- System-Level Safety Instruction for the AI ---
